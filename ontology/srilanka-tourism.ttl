                       slt:Mountain ;
              slt:hasAccessibility slt:DifficultAccess ;
              slt:hasHeritageStatus slt:NationalHeritage ;
              slt:hostsFestival slt:SriPadaSeason ;
              slt:locatedInCity slt:Hatton ;
              slt:offersActivity slt:HikingActivity ,
                                 slt:PhotographyActivity ,
                                 slt:TempleVisitActivity ;
              slt:annualVisitorsThousands 250 ;
              slt:averageVisitDurationHours 7 ;
              slt:elevationMetres 2243 ;
              slt:entranceFeeLKR 0 ;
              slt:openOnPoyaDays "true"^^xsd:boolean ;
