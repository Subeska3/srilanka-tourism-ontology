    <EquivalentClasses>
        <Class IRI="#BudgetAttraction"/>
        <ObjectIntersectionOf>
            <Class IRI="#Attraction"/>
            <DataSomeValuesFrom>
                <DataProperty IRI="#entranceFeeLKR"/>
                <DatatypeRestriction>
                    <Datatype abbreviatedIRI="xsd:decimal"/>
                    <FacetRestriction facet="http://www.w3.org/2001/XMLSchema#maxExclusive">
                        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">2500</Literal>
                    </FacetRestriction>
                </DatatypeRestriction>
            </DataSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>
