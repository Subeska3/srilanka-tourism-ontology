    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:created"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#date">2026-08-29</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:creator"/>
        <Literal xml:lang="en">MSc in Artificial Intelligence, University of Moratuwa</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:description"/>
        <Literal xml:lang="en">An OWL 2 DL ontology describing tourist attractions in Sri Lanka, the
administrative locations that contain them, the activities they offer, the festivals they host and
the accommodation that serves them. Built for the Semantic Web and Ontologies coursework
assignment: it is designed so that a description-logic reasoner derives location, classification and
relationship facts that are never asserted directly.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:title"/>
        <Literal xml:lang="en">Sri Lanka Tourism and Cultural Heritage Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Namespace prefix slt:. All local names use UpperCamelCase for classes and individuals, lowerCamelCase for properties.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>1.0</Literal>
    </Annotation>
