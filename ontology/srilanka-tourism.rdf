<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#"
     xml:base="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:slt="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism">
        <dcterms:creator xml:lang="en">MSc in Artificial Intelligence, University of Moratuwa</dcterms:creator>
        <dcterms:description xml:lang="en">An OWL 2 DL ontology describing tourist attractions in Sri Lanka, the
administrative locations that contain them, the activities they offer, the festivals they host and
the accommodation that serves them. Built for the Semantic Web and Ontologies coursework
assignment: it is designed so that a description-logic reasoner derives location, classification and
relationship facts that are never asserted directly.</dcterms:description>
        <dcterms:title xml:lang="en">Sri Lanka Tourism and Cultural Heritage Ontology</dcterms:title>
        <rdfs:comment xml:lang="en">Namespace prefix slt:. All local names use UpperCamelCase for classes and individuals, lowerCamelCase for properties.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasProvenance -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasProvenance">
        <rdfs:comment xml:lang="en">Free-text note recording where a fact about an individual came from.</rdfs:comment>
        <rdfs:label xml:lang="en">has provenance</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#cityInDistrict -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#cityInDistrict">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#withinArea"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#District"/>
        <rdfs:comment xml:lang="en">A city lies in exactly one district.</rdfs:comment>
        <rdfs:label xml:lang="en">city in district</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#districtInProvince -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#districtInProvince">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#withinArea"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#District"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Province"/>
        <rdfs:comment xml:lang="en">A district lies in exactly one province.</rdfs:comment>
        <rdfs:label xml:lang="en">district in province</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasAccessibility -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasAccessibility">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AccessibilityLevel"/>
        <rdfs:comment xml:lang="en">Links an attraction to exactly one value from the accessibility value partition.</rdfs:comment>
        <rdfs:label xml:lang="en">has accessibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasAttraction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasAttraction">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInCity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:comment xml:lang="en">Inverse of locatedInCity. Never asserted; always inferred.</rdfs:comment>
        <rdfs:label xml:lang="en">has attraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasCapitalCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasCapitalCity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Province"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City"/>
        <rdfs:comment xml:lang="en">A province has exactly one capital, and a city is the capital of at most one province.</rdfs:comment>
        <rdfs:label xml:lang="en">has capital city</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasHeritageStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasHeritageStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HeritageStatus"/>
        <rdfs:comment xml:lang="en">A formal heritage designation held by the attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">has heritage status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasNearbyAccommodation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasNearbyAccommodation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#servesAttraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation"/>
        <rdfs:comment xml:lang="en">Inverse of servesAttraction. Never asserted; always inferred.</rdfs:comment>
        <rdfs:label xml:lang="en">has nearby accommodation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hostsFestival -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hostsFestival">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Festival"/>
        <rdfs:comment xml:lang="en">A festival held at this attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">hosts festival</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInCity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City"/>
        <rdfs:comment xml:lang="en">Relates an attraction to the city or town it sits in.</rdfs:comment>
        <rdfs:label xml:lang="en">located in city</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInProvince -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInProvince">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Province"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInCity"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#cityInDistrict"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#districtInProvince"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">Province of an attraction. Never asserted: derived by the property chain locatedInCity o cityInDistrict o districtInProvince.</rdfs:comment>
        <rdfs:label xml:lang="en">located in province</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#nearbyAttraction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#nearbyAttraction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:comment xml:lang="en">Two attractions close enough to visit on the same day. Symmetric, so only one direction is asserted.</rdfs:comment>
        <rdfs:label xml:lang="en">nearby attraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#offersActivity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#offersActivity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity"/>
        <rdfs:comment xml:lang="en">An activity a visitor can do at this attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">offers activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#servesAttraction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#servesAttraction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:comment xml:lang="en">Accommodation within convenient reach of an attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">serves attraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#visited -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#visited">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Visitor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:comment xml:lang="en">Records that a visitor has been to an attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">visited</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#withinArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#withinArea">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location"/>
        <rdfs:comment xml:lang="en">Transitive containment between locations. cityInDistrict and districtInProvince are sub-properties, so a city is inferred to be within its province.</rdfs:comment>
        <rdfs:label xml:lang="en">within area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#annualVisitorsThousands -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#annualVisitorsThousands">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Approximate yearly visitor count, in thousands.</rdfs:comment>
        <rdfs:label xml:lang="en">annual visitors (thousands)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#averageVisitDurationHours -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#averageVisitDurationHours">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Typical time a visitor spends at the attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">average visit duration (hours)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#elevationMetres -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#elevationMetres">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Height above mean sea level.</rdfs:comment>
        <rdfs:label xml:lang="en">elevation (metres)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#entranceFeeLKR -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#entranceFeeLKR">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Foreign-visitor entrance fee in Sri Lankan rupees. Exactly one value per attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">entrance fee (LKR)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasStarRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasStarRating">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Tourist-board star rating of an accommodation, 1 to 5.</rdfs:comment>
        <rdfs:label xml:lang="en">has star rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#inscribedYear -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#inscribedYear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Year the site received its heritage designation.</rdfs:comment>
        <rdfs:label xml:lang="en">inscribed year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#openOnPoyaDays -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#openOnPoyaDays">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the site admits visitors on full-moon poya holidays.</rdfs:comment>
        <rdfs:label xml:lang="en">open on poya days</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AccessibilityLevel -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AccessibilityLevel">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#DifficultAccess"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#EasyAccess"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ModerateAccess"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">How hard the attraction is to reach. Exhaustively partitioned into Easy, Moderate and Difficult.</rdfs:comment>
        <rdfs:label xml:lang="en">Accessibility level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation">
        <rdfs:comment xml:lang="en">A place where visitors stay overnight.</rdfs:comment>
        <rdfs:label xml:lang="en">Accommodation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity">
        <rdfs:comment xml:lang="en">Something a visitor can do at an attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AdventureActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AdventureActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity"/>
        <rdfs:comment xml:lang="en">A physically demanding outdoor activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Adventure activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ArchaeologicalSite -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ArchaeologicalSite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction"/>
        <rdfs:comment xml:lang="en">An excavated or conserved ancient settlement or monument.</rdfs:comment>
        <rdfs:label xml:lang="en">Archaeological site</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any site in Sri Lanka that a visitor may travel to see. Root of the attraction taxonomy.</rdfs:comment>
        <rdfs:label xml:lang="en">Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Beach -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Beach">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction"/>
        <rdfs:comment xml:lang="en">A coastal sand or rock shoreline visited for recreation.</rdfs:comment>
        <rdfs:label xml:lang="en">Beach</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#BuddhistTemple -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#BuddhistTemple">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ReligiousSite"/>
        <rdfs:comment xml:lang="en">A vihara, dagaba or cave temple of the Buddhist tradition.</rdfs:comment>
        <rdfs:label xml:lang="en">Buddhist temple</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#BudgetAttraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#BudgetAttraction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#entranceFeeLKR"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2500</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction whose entrance fee is below LKR 2500. Uses an OWL 2 datatype restriction on a data property.</rdfs:comment>
        <rdfs:label xml:lang="en">Budget attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CentralProvinceAttraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CentralProvinceAttraction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInProvince"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CentralProvince"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction located in the Central Province. Membership depends entirely on the locatedInProvince property chain.</rdfs:comment>
        <rdfs:label xml:lang="en">Central Province attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Church -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Church">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ReligiousSite"/>
        <rdfs:comment xml:lang="en">A Christian place of worship.</rdfs:comment>
        <rdfs:label xml:lang="en">Church</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location"/>
        <rdfs:comment xml:lang="en">A city or town within a district.</rdfs:comment>
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CoastalAttraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CoastalAttraction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#locatedInCity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CoastalCity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction located in a coastal city.</rdfs:comment>
        <rdfs:label xml:lang="en">Coastal attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CoastalCity -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CoastalCity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#City"/>
        <rdfs:comment xml:lang="en">A city that lies on the coastline. Used to derive coastal attractions.</rdfs:comment>
        <rdfs:label xml:lang="en">Coastal city</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ColonialFort -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ColonialFort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction"/>
        <rdfs:comment xml:lang="en">A Portuguese, Dutch or British military fortification.</rdfs:comment>
        <rdfs:label xml:lang="en">Colonial fort</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity"/>
        <rdfs:comment xml:lang="en">An activity centred on heritage, religion or local tradition.</rdfs:comment>
        <rdfs:label xml:lang="en">Cultural activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction"/>
        <rdfs:comment xml:lang="en">An attraction whose primary value is human-made: religious, archaeological or colonial.</rdfs:comment>
        <rdfs:label xml:lang="en">Cultural attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#DifficultAccess -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#DifficultAccess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AccessibilityLevel"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#District -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#District">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location"/>
        <rdfs:comment xml:lang="en">An administrative district within a province.</rdfs:comment>
        <rdfs:label xml:lang="en">District</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#DomesticVisitor -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#DomesticVisitor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Visitor"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ForeignVisitor"/>
        <rdfs:label xml:lang="en">Domestic visitor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#EasyAccess -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#EasyAccess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AccessibilityLevel"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#EcoLodge -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#EcoLodge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation"/>
        <rdfs:label xml:lang="en">Eco lodge</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Festival -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Festival">
        <rdfs:comment xml:lang="en">A recurring cultural or religious event hosted at an attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">Festival</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ForeignVisitor -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ForeignVisitor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Visitor"/>
        <rdfs:label xml:lang="en">Foreign visitor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Guesthouse -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Guesthouse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation"/>
        <rdfs:label xml:lang="en">Guesthouse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HeritageStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HeritageStatus">
        <rdfs:comment xml:lang="en">A formal heritage designation held by an attraction.</rdfs:comment>
        <rdfs:label xml:lang="en">Heritage status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HinduKovil -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HinduKovil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ReligiousSite"/>
        <rdfs:comment xml:lang="en">A Hindu temple, called a kovil in Sri Lankan usage.</rdfs:comment>
        <rdfs:label xml:lang="en">Hindu kovil</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HistoricLandmark -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HistoricLandmark">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction"/>
        <rdfs:comment xml:lang="en">A notable engineering or civic structure of historic interest, such as a colonial-era bridge.</rdfs:comment>
        <rdfs:label xml:lang="en">Historic landmark</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Hotel -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Hotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Accommodation"/>
        <rdfs:label xml:lang="en">Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location">
        <rdfs:comment xml:lang="en">An administrative or geographic place. Provinces contain districts, districts contain cities.</rdfs:comment>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ModerateAccess -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ModerateAccess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AccessibilityLevel"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Mosque -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Mosque">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ReligiousSite"/>
        <rdfs:comment xml:lang="en">An Islamic place of worship.</rdfs:comment>
        <rdfs:label xml:lang="en">Mosque</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Mountain -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Mountain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction"/>
        <rdfs:comment xml:lang="en">A peak or highland summit reached on foot.</rdfs:comment>
        <rdfs:label xml:lang="en">Mountain</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#MultiActivityDestination -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#MultiActivityDestination">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#offersActivity"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction offering three or more distinct activities. Uses a qualified minimum cardinality restriction.</rdfs:comment>
        <rdfs:label xml:lang="en">Multi-activity destination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NationalPark -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NationalPark">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction"/>
        <rdfs:comment xml:lang="en">A protected wildlife reserve managed by the Department of Wildlife Conservation.</rdfs:comment>
        <rdfs:label xml:lang="en">National park</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
        <rdfs:comment xml:lang="en">An attraction whose primary value is a landscape, ecosystem or geological feature.</rdfs:comment>
        <rdfs:label xml:lang="en">Natural attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#PilgrimageDestination -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#PilgrimageDestination">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hostsFestival"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Festival"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction that hosts at least one festival.</rdfs:comment>
        <rdfs:label xml:lang="en">Pilgrimage destination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Province -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Province">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Location"/>
        <rdfs:comment xml:lang="en">One of the nine provinces of Sri Lanka.</rdfs:comment>
        <rdfs:label xml:lang="en">Province</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ReligiousSite -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#ReligiousSite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#CulturalAttraction"/>
        <rdfs:comment xml:lang="en">A place of active worship that also receives visitors.</rdfs:comment>
        <rdfs:label xml:lang="en">Religious site</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#UNESCOWorldHeritageSite -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#UNESCOWorldHeritageSite">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#hasHeritageStatus"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#UNESCOWorldHeritage"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction whose heritage status is the UNESCO World Heritage designation.</rdfs:comment>
        <rdfs:label xml:lang="en">UNESCO World Heritage site</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Visitor -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Visitor">
        <rdfs:comment xml:lang="en">A person who visits attractions.</rdfs:comment>
        <rdfs:label xml:lang="en">Visitor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Waterfall -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Waterfall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NaturalAttraction"/>
        <rdfs:comment xml:lang="en">A named cascade visited as a scenic site.</rdfs:comment>
        <rdfs:label xml:lang="en">Waterfall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#WildlifeActivity -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#WildlifeActivity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Activity"/>
        <rdfs:comment xml:lang="en">An activity centred on observing wild animals.</rdfs:comment>
        <rdfs:label xml:lang="en">Wildlife activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#WildlifeDestination -->

    <owl:Class rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#WildlifeDestination">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Attraction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#offersActivity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#WildlifeActivity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">DEFINED: an Attraction that offers at least one wildlife activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Wildlife destination</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AdamsPeak -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#AdamsPeak">
        <rdf:type rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Mountain"/>
        <hasAccessibility rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#DifficultAccess"/>
        <hasHeritageStatus rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#NationalHeritage"/>
        <hostsFestival rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#SriPadaSeason"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#Hatton"/>
        <offersActivity rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#HikingActivity"/>
        <offersActivity rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#PhotographyActivity"/>
        <offersActivity rdf:resource="http://www.semanticweb.org/lk/ontologies/2026/srilanka-tourism#TempleVisitActivity"/>
        <annualVisitorsThousands rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250</annualVisitorsThousands>
        <averageVisitDurationHours rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7</averageVisitDurationHours>
        <elevationMetres rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2243</elevationMetres>
        <entranceFeeLKR rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</entranceFeeLKR>
        <openOnPoyaDays rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</openOnPoyaDays>
        <rdfs:comment xml:lang="en">Conical summit venerated by four religions, climbed overnight during pilgrimage season.</rdfs:comment>
